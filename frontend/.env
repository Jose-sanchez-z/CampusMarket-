# =====================================================================
# Variables de entorno del frontend (Vite solo expone las que empiezan por VITE_).
# Este archivo NO debe contener secretos: todo lo que hay aquí termina
# visible en el navegador. Para valores personales usa .env.local (ignorado por git).
# =====================================================================

# URL base de la API (Spring Boot en local).
VITE_API_URL=http://localhost:8080

# Dominio de correo obligatorio en el registro.
# VACÍO = se acepta cualquier correo válido (Gmail, Hotmail, institucional...).
# Ejemplo para exigir el institucional: VITE_DOMINIO_INSTITUCIONAL=unipamplona.edu.co
# Debe coincidir con la validación del backend (S1-T09, E07).
VITE_DOMINIO_INSTITUCIONAL=

# Longitud mínima de la contraseña. Debe coincidir con la regla del backend.
VITE_PASSWORD_MIN=8

# Modo simulado: true = no llama a la API real, responde 202 o 409
# (409 si el correo empieza por "duplicado"). Solo para maquetar sin backend.
VITE_API_SIMULADA=false
